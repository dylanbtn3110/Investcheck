{
  "$description": "InvestCheck design tokens. Espejo de assets/css/tokens.css: si cambias uno, actualiza el otro.",
  "color": {
    "primary": "#1D4ED8",
    "primaryHover": "#1E40AF",
    "primaryDark": "#0B1B3F",
    "secondary": "#0F766E",
    "surfaceTint": "#EFF4FF",
    "primaryOnDark": "#93B4FF",
    "risk": {
      "low": { "fg": "#15803D", "bg": "#DCFCE7" },
      "medium": { "fg": "#B45309", "bg": "#FEF3C7" },
      "high": { "fg": "#B91C1C", "bg": "#FEE2E2" }
    },
    "neutral": {
      "ink": "#0F172A",
      "gray600": "#475569",
      "gray300": "#CBD5E1",
      "gray100": "#F1F5F9",
      "white": "#FFFFFF"
    }
  },
  "font": {
    "display": "Plus Jakarta Sans",
    "body": "Inter",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "typography": {
    "display": { "family": "display", "weight": 800, "size": 48, "lineHeight": 56 },
    "h1": { "family": "display", "weight": 700, "size": 36, "lineHeight": 44 },
    "h2": { "family": "display", "weight": 700, "size": 28, "lineHeight": 36 },
    "h3": { "family": "display", "weight": 600, "size": 22, "lineHeight": 28 },
    "bodyL": { "family": "body", "weight": 400, "size": 18, "lineHeight": 28 },
    "body": { "family": "body", "weight": 400, "size": 16, "lineHeight": 24 },
    "label": { "family": "body", "weight": 600, "size": 14, "lineHeight": 20 },
    "caption": { "family": "body", "weight": 400, "size": 12, "lineHeight": 16 }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "2xl": 48, "3xl": 80 },
  "radius": { "badge": 6, "control": 10, "card": 16, "modal": 28 },
  "breakpoints": {
    "mobile": { "min": 360, "columns": 4, "gutter": 16, "margin": 16 },
    "tablet": { "min": 600, "columns": 8, "gutter": 24, "margin": 32 },
    "desktop": { "min": 1024, "columns": 12, "gutter": 24, "margin": "auto" },
    "desktopWide": { "min": 1440, "columns": 12, "gutter": 32, "margin": "auto", "maxWidth": 1200 }
  },
  "touchTarget": { "web": 44, "android": 48, "ios": 44 },
  "motion": { "fast": 150, "base": 200, "easing": "ease-out" }
}
